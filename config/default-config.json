{
  "gateway": {
    "bindAddress": "127.0.0.1",
    "port": 8080,
    "requireLocalAuth": true,
    "maxRequestBodyBytes": 2097152,
    "rateLimitPerMinute": 120,
    "requestTimeoutSeconds": 60,
    "streamingAllowed": true,
    "activeProvider": "OPENAI",
    "activeProfileId": "developer"
  },
  "enabledDetectors": {
    "RegexDetector": true,
    "SecretDetector": true,
    "NameDetector": true,
    "CodeIdentifierDetector": true,
    "CustomRuleDetector": true
  },
  "persistentVaultEnabled": false,
  "sessionTtlMinutes": 60,
  "logRetentionDays": 14,
  "logPromptPreviews": false,
  "reducedMotion": false,
  "minimizeToTray": true,
  "desktopNotifications": true
}
